{
  "name": "vitrine-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:packages": "bun scripts/build-package.ts",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write . && bun run typecheck && bun test",
    "check:ci": "biome check . && bun run typecheck && bun test",
    "build:docs": "bun run --cwd packages/docs build",
    "build:pod": "bun run --cwd packages/pod-host build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
